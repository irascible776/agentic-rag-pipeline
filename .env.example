# Google Gemini API Key (Required for generation and embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase pgvector Configuration (Optional)
# If provided, vectors are stored in Supabase PostgreSQL with pgvector.
# If omitted or empty, the pipeline automatically runs with local ChromaDB storage.
SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration (Optional)
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*
